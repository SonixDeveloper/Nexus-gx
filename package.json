{
  "name": "nexus-gx",
  "productName": "NEXUS GX",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Desktop gaming browser powered by Chromium",
  "author": "NEXUS GX",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && node scripts/build.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:integration": "electron . --nexus-smoke",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "motion": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/yauzl": "^2.10.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.8"
  },
  "homepage": "https://github.com",
  "desktopName": "io.github.nexusgx.NexusGX.desktop"
}
